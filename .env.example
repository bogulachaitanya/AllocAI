# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./projectmind.db

# ─── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ─── Hindsight ────────────────────────────────────────────────────────────────
# Set to "local" to use the mock SQLite adapter (no credentials required)
HINDSIGHT_ADAPTER=local
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=

# ─── RAG ──────────────────────────────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5

# ─── Security ─────────────────────────────────────────────────────────────────
# Comma-separated admin usernames (demo only; use proper auth in production)
ADMIN_USERS=admin

# ─── Seed ─────────────────────────────────────────────────────────────────────
SEED_EMPLOYEE_COUNT=150
